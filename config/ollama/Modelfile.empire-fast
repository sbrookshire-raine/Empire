# EMPIRE Fast chat model — baked parameters for the OpenAI-compat endpoint.
#
# Why: Ollama's OpenAI-compatible endpoint ignores per-request `options` (measured: a request
# with num_predict=24 generated 458 tokens; num_ctx=8192 left the model loaded at 4096). So the
# only place these limits stick is the model itself. Without a prediction cap one degenerate
# reply can run for ~90 s; without the context default the ~10k-token Eve prompt gets truncated.
#
# Build:  .\scripts\build-empire-ollama-models.ps1
# Used by: agents/empire-task-agent/agent/lib/ollama-config.ts (CHAT_MODES.fast)

FROM qwen2.5:14b-instruct

PARAMETER num_ctx 16384
# 512 was too small (measured 2026-09-24): on a reasoning-heavy ask the model spends the whole budget
# inside its `<thought>` block, generation stops mid-thought, the sanitizer strips the block and the
# visible answer is EMPTY — the harness reports "empty model response", retries once, and the turn ends
# in an apology after ~300 s. 1024 leaves room for the protocol *and* an answer.
PARAMETER num_predict 1024
PARAMETER temperature 0.2
PARAMETER top_p 0.9
