        "verbs": ["recall", "remember", "remind", "recollect"],
        "nouns": ["memory", "memories", "interests"],
        "phrases": [
          "what do you know about me",
          "what did we decide",
          "from memory",
          "in memory",
          "what are my",
          "what do we already have",
          "did we already build",
          "continue not start",
          "four architectures",
          "obsidian vault",
          "gemini convo",
          "extracted gemini",
          "language barrier",
          "how i talk",
          "words i use",
          "architect intent vocabulary",
          "vault and dialogue"
        ]
      },
      "policy": {
        "local_first": true,
        "local_tools": ["cognee_recall"],
        "online_tools": [],
        "limbs": [],
        "playbook": "memory-and-ideas",
        "datasets": ["eve_core", "eve_memory", "primitives_test"]
      }
    },
