# Copy to config/heptabase.env (gitignored) after running scripts/ensure-heptabase-disassembly-board.ps1
# Heptabase desktop app must be running with Local CLI enabled.

# Catalog whiteboard UUID (EMPIRE Disassembly Catalog)
HEPTABASE_DISASSEMBLY_WHITEBOARD_ID=

# Optional: full path to heptabase.cmd if not on PATH
# HEPTABASE_CLI_PATH=C:\Users\YOU\.heptabase\bin\heptabase.cmd
