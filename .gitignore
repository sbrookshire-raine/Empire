.env.local
.env

# PocketBase
backend/pocketbase/pb_data/
backend/pocketbase/pocketbase.exe
backend/pocketbase/pocketbase.zip

# Cognee
cognee/.cognee_system/

# Eve
agents/**/node_modules/
agents/**/.eve/
agents/**/.next/
agents/**/.output/

# Runtime upload/job state (regenerated by Workbench)
data/eve_memory/uploads/
data/eve_memory/jobs/

# Local Cognee env override
cognee/.env

# Dashboard runtime snapshots (regenerated by refresh-dashboard.ps1)
frontend/dashboard-status.json

# OS
.DS_Store
Thumbs.db

data/cognee_system/
config/cognee.env

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local scratch: debug logs, edit backups, one-off probes (never commit)
/tmp/

# Eve ambient audit log — runtime chat transcript, privacy-sensitive
/eve-audit/

# SQLite WAL/SHM sidecars (live DB state, not source)
*.db-shm
*.db-wal

# Runtime capture logs from eval/verification runs
data/eval/*_stdout.txt
data/eval/*_stderr.txt

# Regenerated integration report
frontend/verify-stack.json

