# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environment and secrets
.env.local
.env

# PocketBase
backend/pocketbase/pb_data/
backend/pocketbase/pocketbase.exe
backend/pocketbase/pocketbase.zip

# Cognee
cognee/.cognee_system/

# Eve
agents/**/node_modules/
agents/**/.eve/
agents/**/.next/
agents/**/.output/

# Runtime upload/job state (regenerated by Workbench)
data/eve_memory/uploads/
data/eve_memory/jobs/

# Local Cognee env override
cognee/.env

# Dashboard runtime snapshots (regenerated by refresh-dashboard.ps1)
frontend/dashboard-status.json

# OS
.DS_Store
Thumbs.db

data/cognee_system/
config/cognee.env

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local scratch: debug logs, edit backups, one-off probes (never commit)
/tmp/

# Eve ambient audit log — runtime chat transcript, privacy-sensitive
/eve-audit/
# generated by refresh-dashboard.ps1 — status.json snapshot copies, not source
# (policy: docs/OPERATING_CONTRACT.md section 6, generated trees are never tracked)
backend/pocketbase/pb_public/dashboard/

# SQLite WAL/SHM sidecars (live DB state, not source)
*.db-shm
*.db-wal

# Runtime capture logs from eval/verification runs
data/eval/*_stdout.txt
data/eval/*_stderr.txt

# Regenerated integration report
frontend/verify-stack.json


# Cursor MCP configs carry LOCAL SERVICE CREDENTIALS (WEAVIATE_API_KEY, PocketBase admin).
# The canonical repo is PUBLIC, so these must not be tracked. Sanitized structure lives in
# .cursor/mcp.example.json and .cursor/mcp.full.example.json (credentials -> REPLACE_ME).
# Exposure found by gitleaks 2026-09-26: docs/audits/2026-09-26-infra-adoption.md
/.cursor/mcp.json
/.cursor/mcp.full.json
# Same class as mcp.json / mcp.full.json - found by a follow-up grep, not by the first pass.
/.cursor/mcp.lean.json
/.cursor/mcp.remote.json
