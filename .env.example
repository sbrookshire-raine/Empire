# EMPIRE local environment (copy to .env.local)

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@empire.local
POCKETBASE_ADMIN_PASSWORD=empire-admin-change-me

# Ollama (Operational Phase)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Cognee
COGNEE_SYSTEM_ROOT=./cognee/.cognee_system

# Wikipedia / Wiki Local
# Default (blank/0): Eve owns retrieval and calls the empire-wiki-scout MCP tools
# herself (wiki_scout_search / wiki_resolve / wiki_extract / wiki_read_section).
# Set to 1 to restore the legacy regex middleware that injects
# [[EMPIRE_WIKI_LOOKUP]] / [[EMPIRE_WIKI_EXTRACT]] / [[EMPIRE_WIKI_DRIFT]] evidence
# before the turn (escape hatch; also un-registers the wiki tools for that turn).
EMPIRE_WIKI_MIDDLEWARE=0

# Future live connectors (leave blank during build)
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
GMAIL_CREDENTIALS_PATH=
