{
  "mcpServers": {
    "empire-cognee": {
      "command": "C:/EMPIRE/venv/Scripts/python.exe",
      "args": [
        "C:/EMPIRE/mcp/cognee_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "C:/EMPIRE"
      }
    },
    "empire-pocketbase": {
      "command": "C:/EMPIRE/venv/Scripts/python.exe",
      "args": [
        "C:/EMPIRE/mcp/pocketbase_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "C:/EMPIRE",
        "POCKETBASE_URL": "http://127.0.0.1:8090",
        "POCKETBASE_ADMIN_EMAIL": "admin@empire.local",
        "POCKETBASE_ADMIN_PASSWORD": "empire-admin-change-me"
      }
    },
    "empire-workbench": {
      "command": "C:/EMPIRE/venv/Scripts/python.exe",
      "args": [
        "C:/EMPIRE/mcp/workbench_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "C:/EMPIRE",
        "EMPIRE_WORKBENCH_DIR": "C:/Empire_Workbench",
        "EMPIRE_ACTIVE_TOOLS_DIR": "C:/Empire_Workbench/03_Active_Tools"
      }
    },
    "empire-work-orders": {
      "command": "C:/EMPIRE/venv/Scripts/python.exe",
      "args": [
        "C:/EMPIRE/mcp/work_order_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "C:/EMPIRE",
        "EMPIRE_WORK_ORDERS_DIR": "C:/Empire_Workbench/05_Work_Orders",
        "EMPIRE_RESOURCE_QUEUE_DIR": "C:/Empire_Workbench/00_Resource_Queue"
      }
    },
    "empire-tool-forge": {
      "command": "C:/EMPIRE/venv/Scripts/python.exe",
      "args": [
        "C:/EMPIRE/mcp/tool_forge_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "C:/EMPIRE",
        "EMPIRE_HARVEST_CACHE_DIR": "C:/Empire_Workbench/04_Thought_Experiments/harvest_cache",
        "EMPIRE_ACTIVE_TOOLS_DIR": "C:/Empire_Workbench/03_Active_Tools",
        "EMPIRE_CURSOR_SKILLS_DIR": "C:/EMPIRE/.cursor/skills"
      }
    },
    "empire-loom-intake": {
      "command": "C:/EMPIRE/venv/Scripts/python.exe",
      "args": [
        "C:/EMPIRE/mcp/loom_intake_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "C:/EMPIRE",
        "EMPIRE_LOOM_ROOT": "C:/Empire_Workbench/04_Thought_Experiments/loom",
        "EMPIRE_RESOURCE_QUEUE_DIR": "C:/Empire_Workbench/00_Resource_Queue"
      }
    },
    "graft": {
      "command": "npx",
      "args": [
        "-y",
        "@nanonets/graft",
        "mcp"
      ]
    }
  }
}
